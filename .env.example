# Telegram Bot Token (@BotFather dan olingan)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Kaliti (https://aistudio.google.com dan olingan)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model nomi
AI_MODEL_NAME=gemini-2.5-flash

# Administrator ma'lumotlari (kerak bo'lsa foydalanuvchiga taqdim etiladi)
ADMIN_USERNAME=@maktab_admin
ADMIN_PHONE=+998901234567

# Cheklovlar (xarajat va xavfsizlik nazorati)
MAX_INPUT_CHARS=1000
MAX_OUTPUT_TOKENS=800
CONVERSATION_HISTORY_LIMIT=6
